# =============================================================================
# Contour — environment variable reference
# =============================================================================
# Copy to .env and fill in. Every variable below is read by exactly one place in
# the code; see docs/deployment.md for the authoritative table of which service
# consumes which variable.
#
# Variables marked REQUIRED must be set for the service to start. Variables
# marked OPTIONAL gate a specific capability: when unset, that capability
# reports an explicit disabled state (name, reason, and what to set) rather than
# degrading into fabricated output. See docs/architecture.md, "Disabled states".
# =============================================================================

# -----------------------------------------------------------------------------
# Core services  (REQUIRED)
# -----------------------------------------------------------------------------
CONTOUR_ENV=development
CONTOUR_DATABASE_URL=postgresql+psycopg://contour:contour@127.0.0.1:5432/contour
CONTOUR_REDIS_URL=redis://127.0.0.1:6379/0
CONTOUR_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CONTOUR_API_BASE_URL=http://127.0.0.1:8000

# Signing key for sessions and share tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTOUR_SECRET_KEY=change-me-in-every-environment

# Encryption key for external account tokens at rest (§20.2). Fernet key,
# generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTOUR_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Routing engine — Valhalla  (REQUIRED for route generation)
# -----------------------------------------------------------------------------
# Contour builds Valhalla from source; see infra/valhalla/build.sh and
# docs/deployment.md. VALHALLA_URL must point at a valhalla_service HTTP
# endpoint. Without it, RoutingProvider reports disabled and no route is
# generated — no fallback geometry is ever invented.
CONTOUR_VALHALLA_URL=http://127.0.0.1:8002
CONTOUR_VALHALLA_TILE_DIR=/opt/contour/valhalla-tiles
CONTOUR_VALHALLA_CONFIG=/opt/contour/valhalla.json

# -----------------------------------------------------------------------------
# Elevation  (OPTIONAL — without it, elevation is reported as unknown)
# -----------------------------------------------------------------------------
# ElevationProvider selection: "valhalla" (uses Valhalla's /height, requires
# elevation tiles built into CONTOUR_VALHALLA_TILE_DIR), "raster" (reads local
# DEM GeoTIFF/HGT via rasterio), or "none".
#
# Contour never interpolates beyond what the DEM supports and never substitutes
# a value for missing elevation; see docs/elevation_method.md.
CONTOUR_ELEVATION_PROVIDER=none
CONTOUR_ELEVATION_RASTER_DIR=/opt/contour/dem
# Free-text identifier of the DEM actually installed, recorded against every
# elevation sample for provenance, e.g. "Copernicus DEM GLO-30 (2021 release)".
CONTOUR_ELEVATION_DATASET_ID=

# -----------------------------------------------------------------------------
# Basemap  (OPTIONAL — without it, the map renders Contour's own vector layers
# on a blank canvas and shows a "no basemap provider configured" state)
# -----------------------------------------------------------------------------
# MapProvider selection: "maptiler", "protomaps", "self-hosted", or "none".
# Do not point this at tile.openstreetmap.org: the OSMF tile usage policy does
# not permit it as an application backend (§5.9, docs/licensing_and_attribution.md).
NEXT_PUBLIC_CONTOUR_MAP_PROVIDER=none
NEXT_PUBLIC_CONTOUR_MAPTILER_KEY=
NEXT_PUBLIC_CONTOUR_PMTILES_URL=
NEXT_PUBLIC_CONTOUR_TERRAIN_URL=

# -----------------------------------------------------------------------------
# Geocoding  (OPTIONAL — without it, place search is disabled; map clicks and
# coordinate entry still work)
# -----------------------------------------------------------------------------
# GeocodingProvider selection: "pelias", "nominatim-selfhosted", or "none".
# A public Nominatim instance is not an acceptable production backend under its
# usage policy; self-host it or use Pelias.
CONTOUR_GEOCODING_PROVIDER=none
CONTOUR_GEOCODING_URL=

# -----------------------------------------------------------------------------
# Source connectors  (OPTIONAL — each unset connector is reported on the
# Coverage screen with its exact missing requirement, never as zero coverage)
# -----------------------------------------------------------------------------
CONTOUR_OSM_EXTRACT_URL=https://download.geofabrik.de/europe/ireland-and-northern-ireland-latest.osm.pbf
CONTOUR_OVERPASS_URL=
CONTOUR_CKAN_BASE_URL=https://data.gov.ie
CONTOUR_SOURCE_ARCHIVE_DIR=/opt/contour/source-archive

# S3-compatible object storage for imports, exports and source archives.
CONTOUR_S3_ENDPOINT=
CONTOUR_S3_BUCKET=
CONTOUR_S3_ACCESS_KEY_ID=
CONTOUR_S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Natural language intent parsing  (OPTIONAL)
# -----------------------------------------------------------------------------
# IntentParserProvider selection: "deterministic" (default; rule-based, no
# network, no key) or "anthropic". The model may only parse a request into a
# RouteIntent and explain results. It never produces geometry, access, surface,
# elevation, safety, ferry, traffic or service claims (§8.6).
CONTOUR_INTENT_PARSER=deterministic
ANTHROPIC_API_KEY=
CONTOUR_ANTHROPIC_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Observability  (OPTIONAL)
# -----------------------------------------------------------------------------
CONTOUR_LOG_LEVEL=info
CONTOUR_LOG_FORMAT=json
CONTOUR_OTEL_EXPORTER_OTLP_ENDPOINT=
CONTOUR_SENTRY_DSN=
